# ══════════════════════════════════════════════════════════════════════════
# ⚠️ 这不是生产配置，只是模板。生产配置只存在服务器上。
# ══════════════════════════════════════════════════════════════════════════
#
# 为什么分开（2026-10-31 改造）：
#   `deploy/nginx.conf` 曾被 git 跟踪，但服务器上的那份被 certbot **就地改写**
#   （443 启用 + 证书路径 + Basic Auth + CSP），与仓库里的占位版内容不同。
#   每次同步都要手工走「备份 → checkout 丢弃本地改 → merge → 恢复」，极易出错，
#   且一旦某次 merge 把占位版落到生产 ⇒ 443 消失 ⇒ HTTPS 全站 down。
#
#   改法：生产配置不入库（见 .gitignore），仓库只保留本模板。
#
# 新环境初始化：
#   cp deploy/nginx.conf.example deploy/nginx.conf
#   bash deploy/generate-htpasswd.sh              # 生成 Basic Auth 账号
#   certbot --nginx -d <你的域名>                  # 自动追加 443 块并申请证书
#   docker compose up -d nginx
#
# 已有环境改配置：
#   **直接在服务器上编辑** `/home/admin/scireagent/deploy/nginx.conf`，
#   不要把本模板 scp/覆盖过去（会抹掉 443 配置）。
#   改完必须 `docker compose restart nginx`（bind mount 按 inode 挂载，reload 不够）。
#
# 验证三件套（改完必跑）：
#   docker exec scireagent-nginx-1 grep -c 'listen 443' /etc/nginx/conf.d/default.conf
#   curl -sk -o /dev/null -w '%{http_code}\n' https://<域名>/          # 401 或 200
#   curl -sk -o /dev/null -w '%{http_code}\n' https://<域名>/assets/notexist.js  # 404
#
# ══════════════════════════════════════════════════════════════════════════

# SciReAgent 单机全栈 Nginx 配置（docker-compose nginx 服务挂载到 /etc/nginx/conf.d/default.conf）
# 前端 SPA 由 nginx 直接托管；/api /admin 反代到 backend:8000；/static /media 由 nginx 读挂载卷。

# ── 限流（v4.1）：10r/s per IP + burst 20，超限 429（须在 http 级，此文件被 include 进 http{}）──
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

# ── 后端 upstream + keepalive（2026-10-16）──
#   原先 `proxy_pass http://backend:8000;` 直接指 IP 且无 keepalive ⇒ 每个 API 请求
#   都要新建一条到 gunicorn 的 TCP 连接。本机RTT 219ms 且丢包 20%，连接建立的
#   握手开销可观；复用长连接可直接省掉这部分等待。
#   keepalive 64 ≈ 匹配 gunicorn 的 5 workers × 4 threads = 20 并发槽的数倍余量。
upstream backend_upstream {
    server backend:8000;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

# ── HTTP(80)：仅用于 certbot ACME 校验 + 全站 302 跳转到 HTTPS ──
server {
    listen 80;
    server_name scireagent.com www.scireagent.com;

    client_max_body_size 20m;

    # certbot 域名验证路径必须留 http、免认证、不跳转，否则申请/续期 HTTPS 证书会失败
    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /usr/share/nginx/html;
    }

    # 其余 http 流量全部跳转 https（含 SPA / API / 后台）
    location / {
        return 302 https://$host$request_uri;
    }
}

# ── HTTPS(443)：证书由 certbot 写入 ./deploy/certbot/conf，docker-compose 已挂载到
#    容器内 /etc/letsencrypt（只读）。Basic Auth 改在 https 上进行（加密传输，更安全）。──
server {
    listen 443 ssl;
    server_name scireagent.com www.scireagent.com;

    # ── HTTP/2（2026-10-16）：单连接多路复用，消除首屏多资源的队头阻塞 ──
    #   实测首屏需加载 142 个 js/css 资源；HTTP/1.1 下浏览器对同域并发连接有上限，
    #   资源排队串行传输。HTTP/2 把这些资源复用到一条 TCP 连接上。
    #
    #   ⚠️ nginx ≥1.25.1 已弃用 `listen 443 ssl http2;` 写法（会产生弃用告警，
    #   未来版本将报错）。当前生产 nginx/1.31.2，必须用独立的 `http2 on;` 指令。
    #   验证依据：openssl s_client -alpn h2,http/1.1 会协商出 http/1.1（未启用时）。
    http2 on;

    ssl_certificate     /etc/letsencrypt/live/scireagent.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scireagent.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # ── TLS 会话复用（2026-10-16）：实测跨网到本机 RTT 219ms 且丢包 20%，
    #    单次 TLS 1.3 握手实测 1.4~7.3s（抖动极大）。握手是"纯等待"，
    #    服务器 CPU 再高也无济于事，只能靠会话复用把它摊掉。
    #    50m 共享区约可缓存 ~20 万条会话；10m 只有 ~8000 条，对高并发站点偏小。
    ssl_session_cache shared:SSL_sessions:50m;
    ssl_session_timeout 1d;   # 会话有效期 1 天，覆盖用户一天内的多次访问
    ssl_session_tickets on;   # TLS 1.3 下启用 session ticket

    # ── gzip 压缩（2026-10-15）：主 JS 包 1.27MB，未压缩传输是链路耗时主因 ──
    #   实测：主包 1,277,341B → 415,393B（↓67.5%）。低于 gzip_min_length 的小文件（如 index.html 832B）不压缩。
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    client_max_body_size 20m;   # 允许上传较大文件（如 PDF 数据表）

    # ── CSP Report-Only（v4.1 DEV-9）：观察 3-7 天后切 enforce ──
    #  script-src 'self' — Vue 生产 runtime-only 不需 eval
    #  style-src 'unsafe-inline' — Element Plus 动态样式
    #  fonts.googleapis.com/gstatic — Google Fonts CSS + 字体文件
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    # ── 内部访问限制：HTTP Basic Auth（仅限内部测试人员，详见部署文档 §11）──
    auth_basic "SciReAgent Internal Test";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # ── 前端单页应用（SPA）：托管 dist，未匹配路由回退 index.html ──
    root /usr/share/nginx/html;

    # ★ 2026-10-31：/assets/ 绝不能走 SPA fallback。
    #   实测（生产）：请求不存在的 chunk 时 `location /` 的 try_files 会回退到
    #   index.html，返回 **HTTP 200 + text/html**（2,166B）。浏览器把 HTML 当 JS
    #   解析 ⇒ `SyntaxError: Unexpected token '<'`，整块路由组件白屏。
    #   危害不止"报错难懂"：HTTP 层是 200，浏览器/中间缓存可能把这个错误响应缓存
    #   住，导致清缓存前一直坏。改成 $uri =404 ⇒ 缺失即 404，语义正确、不可缓存。
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html 不缓存：部署新构建（清掉旧 chunk）后，避免浏览器沿用缓存的旧
    # index.html 去引用已被删除的旧 chunk 而白屏。哈希资源本身可长缓存（下方默认）。
    location = /index.html {
        add_header Cache-Control "no-cache";
        # ★ CSP 在此重复：nginx add_header 规则 = location 有自己的 add_header 就替换 server 级的全部
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    }

    # ── 后端 API（Django DRF）──
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://backend_upstream;
        # ★ 2026-09-23 修 **B4**：`enrich` 首次冷查询实测 **50.7s**（上游 PubChem/ChEMBL/PubMed 在大陆延迟高），
        #   nginx 默认 `proxy_read_timeout` = **60s** ⇒ 余量不足，曾真的触发过 **504**（用户看到失败）。
        #   这里与**前端 axios 超时 120s**（`frontend/src/api/aiTools.js:59`）**对齐**，消除用户在超时边界上的失败。
        #   仅调等待上限，不改任何业务语义；配 `nginx -s reload` 即生效（本文件 bind-mount 进容器，无需重建镜像）。
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # ★ 必须显式清空 Connection 头，否则 nginx 不会把后端连接放进 keepalive 池
        #   （HTTP/1.1 默认即 close，与上游 keepalive 冲突）
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # ── Django 管理后台 ──
    location /admin/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ── 静态资源（后端 collectstatic 产出，挂载为只读卷）──
    location /static/ {
        alias /usr/share/nginx/static/;
        expires 30d;
        access_log off;
    }

    # ── 敏感上传目录：一律禁止 nginx 直出，必须走 Django 授权视图（2026-10-21 F3/L7）──
    #   发票号 INV-YYYY-NNNN 可枚举、PO 附件是客户上传的原件、COA/SDS 有"未发布 404"门控。
    #   这些文件全部由 FileResponse 交付（InvoicePdfDownloadView / PoAttachmentDownloadView /
    #   CoaViewSet.download / SdsRevisionViewSet.download），走 /media/ 会被完全绕过。
    #   注意：只精确封禁这四棵子树 —— /media/ 下的产品文档（media/pdfs/、
    #   media/documents/ 里的 ProductDocument.file）在序列化器里以 URL 直出，不能整体禁。
    location ^~ /media/invoices/        { deny all; }
    location ^~ /media/po_attachments/  { deny all; }
    location ^~ /media/documents/coa/   { deny all; }
    location ^~ /media/documents/sds/   { deny all; }

    # ── 用户上传媒体 ──
    location /media/ {
        alias /usr/share/nginx/media/;
        expires 30d;
        access_log off;
        add_header X-Content-Type-Options nosniff always;
        # ★ 副作用说明（2026-10-21 F3）：nginx 的 add_header 规则是"location 里出现
        #   任何 add_header，就不再继承 server 级的所有 add_header"。上面加了 nosniff 后，
        #   server 级那条 CSP Report-Only 会**失效**，故此处原样复制一份（同
        #   `location = /index.html` 的做法）。CSP 内容与 server 级 :81 逐字一致。
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    }
}
