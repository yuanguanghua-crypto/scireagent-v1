# SciReAgent 单机全栈生产环境变量（docker-compose backend 服务通过 env_file 读取）
# 复制为 .env 后修改带 < > 的项；不要提交真实 .env（已在 .gitignore）。

# ── Django 核心 ──
SECRET_KEY=<请生成随机串，例如 openssl rand -base64 48>
DEBUG=False
# 你的域名（逗号分隔）；留 * 仅限调试。例：example.com,www.example.com
ALLOWED_HOSTS=<your-domain.com>,<www.your-domain.com>
# 前端来源（与 ALLOWED_HOSTS 对应，含协议）；留空则仅同源
CORS_ALLOWED_ORIGINS=https://<your-domain.com>

# ── 邮件 / 注册邮箱验证 ──
# Mailgun：留空 ANYMAIL_MAILGUN_API_KEY 则降级为 console 后端（验证链接打印到后端日志，零凭据可走通链路）
ANYMAIL_MAILGUN_API_KEY=
DEFAULT_FROM_EMAIL=noreply@<your-domain.com>
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# 验证邮件中的链接基址（前端验证页 /verify-email?token= 拼在此之后）；改成你的前端域名
FRONTEND_BASE_URL=https://<your-domain.com>

# ── 数据库（docker-compose 的 db 服务；backend 通过 DB_HOST=db 访问）──
DB_ENGINE=django.db.backends.postgresql
DB_NAME=scireagent
DB_USER=scireagent
DB_PASSWORD=<强密码>
DB_HOST=db
DB_PORT=5432

# ── 管理员引导（首次启动自动建 superuser，已存在则跳过）──
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@<your-domain.com>
DJANGO_SUPERUSER_PASSWORD=<强管理员密码>

# ── 大数据集路径 ──
# bioprocorpus：一次性 scp 到主机 ./data/bioprocorpus，由 compose 绑定挂载进容器（默认路径即可）
BIOPROCORPUS_DIR=/app/backend/data/bioprocorpus
# jena：已随镜像发布（3MB），无需额外操作；如需指向外部路径可改这里
JENA_DATA_DIR=/app/backend/data/jena

# ── 可选：启动期从私有源拉取 bioprocorpus（替代手动 scp）──
# 不设置则默认关闭（DOWNLOAD_BIOPROC=0），使用已上传的 ./data/bioprocorpus
# DOWNLOAD_BIOPROC=0
# DATASET_BASE_URL=https://<你的对象存储>/bioprocorpus.tar.gz
# 或 HF_DATASET_REPO=<user>/bioprocorpus
