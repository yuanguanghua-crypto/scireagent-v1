# Django
*.sqlite3
db.sqlite3
media/
staticfiles/
static_collected/
.env
local_settings.py

# BioProCorpus 协议语料库（大文件 ~514MB，不进仓库；部署时按需在容器启动期下载，见 scripts/download_bioprocorpus.py）
backend/data/bioprocorpus/

# jena 产品数据集（大文件，来源于 WorkBuddy jena_scraper 项目）
backend/data/jena/*
# 例外：jena 核心 JSONL 仅 3MB，纳入仓库随镜像发布，使 AI AUTO MATCH 默认可用
!backend/data/jena/jena_products_v2.jsonl

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn-integrity

# Vue / Vite
frontend/dist/
frontend/.vite/
*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Environment
.env
.env.local
.env.*.local

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Test artifacts
frontend/test-results/
frontend/playwright-report/

# Claude Code / Agent tooling (personal config)
.claude/
.agents/
skills-lock.json

# Screenshots / scratch images
canvas.png
screenshot.png
screenshot.jpg

# Docx parse scratch media (extracted from uploaded .docx, not source)
_docx_media/

# Migrations (uncomment if you want to ignore)
# **/migrations/*.py
# !**/migrations/__init__.py

# 单机全栈部署：compose 绑定挂载的主机数据目录（bioprocorpus 一次性上传至此，不入库）
/data/

# Basic Auth 密码文件（含哈希，不入库；由 deploy/generate-htpasswd.sh 生成）
deploy/.htpasswd
deploy/.htpasswd.*

# 部署敏感/生成物（不入库）
# CREDENTIALS.txt 由 deploy/setup-env.sh 生成，含 6 个账号明文密码（权限 600）
# certbot/ 含 Let's Encrypt TLS 证书与私钥
# frontend/dist.bak* 为前端构建历史备份目录（占空间，非源码）
deploy/CREDENTIALS.txt
deploy/certbot/
frontend/dist.bak*/
