# Django
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://scireagent:scireagent_dev_2026@localhost:5432/scireagent

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email / 注册邮箱验证
# 留空 ANYMAIL_MAILGUN_API_KEY 则降级为 console 后端（验证链接打印到后端日志，零凭据可走通链路）
ANYMAIL_MAILGUN_API_KEY=
DEFAULT_FROM_EMAIL=noreply@scireagent.com
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# 验证邮件链接基址（前端验证页 /verify-email?token= 拼在此之后）；本地开发改成前端 dev server 地址
FRONTEND_BASE_URL=http://localhost:5173

# Static/Media
STATIC_URL=/static/
MEDIA_URL=/media/
