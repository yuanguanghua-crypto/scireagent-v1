# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database
# ⚠️ 必须是 Django 的**完整 backend 路径**，不是 'postgresql'。
#    写 'postgresql' 会让 ENGINE='postgresql' ⇒ 启动即报
#    "ImproperlyConfigured: 'postgresql' isn't an available database backend"。
#    （2026-10-28 修正：本模板原文就是错的，照抄会起不来。）
# 本地开发请用 scripts/dev_db.sh 起库；若确实要用 sqlite，设 DB_ENGINE=sqlite
# 但注意：sqlite 下禁止 `makemigrations`（settings/base.py 有守卫，会直接报错）。
DB_ENGINE=django.db.backends.postgresql
DB_NAME=scireagent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Static Files
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media
